# Copy to .env and edit. Never commit .env.

# Ollama on the MacBook, reached over Tailscale. Use the 100.x.y.z address (see `tailscale status`).
OLLAMA_BASE_URL=http://100.x.y.z:11434

# PostgreSQL (one container, databases `dagster` and `rag_metrics`)
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

# The database for imported tables (`rag_data`, in the same PostgreSQL). Two roles are made with
# these passwords when the UI starts: one loads data, one only reads. They go into a URL, so use
# letters and digits only.
SQL_LOADER_PASSWORD=change-me-too
SQL_READER_PASSWORD=change-me-as-well
